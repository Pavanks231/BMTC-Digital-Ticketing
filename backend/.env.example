PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated additional browser/app origins; Android Capacitor defaults to https://localhost.
CORS_ALLOWED_ORIGINS=https://localhost
COOKIE_SAME_SITE=lax

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=bmtc_ticketing

# Replace with a random secret of at least 32 characters before running the API.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=12h

# Set private passwords for the fictional local demo accounts before seeding.
DEMO_STUDENT_PASSWORD=replace-with-a-private-demo-password
# Optional separate password; if blank, the seed script uses DEMO_STUDENT_PASSWORD.
DEMO_CONDUCTOR_PASSWORD=
